# Database & Security
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?appName=Cluster0
JWT_SECRET=replace-with-a-secure-random-64-character-secret-key
ENVIRONMENT=production

# CORS (Explicit origins for web/dashboard. Note: Native mobile apps bypass CORS)
ALLOWED_ORIGINS=https://restockiq.com,https://app.restockiq.com,http://localhost:3000,http://127.0.0.1:3000

# Google Gemini LLM
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Security & Demo Flags
ALLOW_DEMO_SEED=false
